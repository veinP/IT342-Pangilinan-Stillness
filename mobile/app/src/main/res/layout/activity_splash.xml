<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <edu.cit.pangilinan.stillness.features.landing.RippleLogoView
        android:id="@+id/rippleLogoView"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <TextView
        android:id="@+id/tvWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="StillNess"
        android:fontFamily="sans-serif-black"
        android:textSize="28sp"
        android:textColor="#1E3A5F"
        android:letterSpacing="-0.02"
        android:alpha="0"
        android:translationY="20dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/rippleLogoView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="find your calm"
        android:textSize="13sp"
        android:textColor="#7a9cc4"
        android:letterSpacing="0.2"
        android:alpha="0"
        android:translationY="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvWordmark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llLoadingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View
            android:id="@+id/dot1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_dot"
            android:alpha="0" />
            
        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot"
            android:alpha="0" />
            
        <View
            android:id="@+id/dot3"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dot"
            android:alpha="0" />
            
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
