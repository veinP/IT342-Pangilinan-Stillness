<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Booking Thumbnail (Parity with Web mb-card__thumb) -->
        <FrameLayout
            android:id="@+id/flBookingThumb"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#F0FDF4">

            <TextView
                android:id="@+id/tvBookingThumbText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Confirmed"
                android:textColor="#15803D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBookingSessionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Session Title"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookingCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hg_rounded"
                    android:backgroundTint="#F0F7FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="YOGA"
                    android:textColor="@color/stillness_blue_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Meta Rows (Parity with Web mb-card__meta-row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_my_calendar" app:tint="@color/text_secondary" />
                    <TextView android:id="@+id/tvBookingDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Mon, Oct 27, 2026" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="@color/text_secondary" />
                    <TextView android:id="@+id/tvBookingTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="10:00 AM - 11:00 AM" android:textColor="@color/text_secondary" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/border_divider" />

            <!-- Details Section (Parity with Web mb-card__details) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Booking #:" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvBookingNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@color/black" android:textSize="12sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Amount:" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvBookingPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:textColor="@color/black" android:textSize="12sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Payment:" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvPaymentStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:text="PAID" android:textColor="#15803D" android:textSize="12sp" android:textStyle="bold" />
            </GridLayout>

            <!-- Actions Section (Parity with Web mb-card__actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBookingStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hg_rounded"
                    android:backgroundTint="#F0FDF4"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="CONFIRMED"
                    android:textColor="#15803D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnViewSessionDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View Details"
                    android:textColor="@color/stillness_blue_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="8dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
