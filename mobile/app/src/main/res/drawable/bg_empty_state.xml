    android:shape="rectangle">
    <solid android:color="#F8FBFF" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#BFDBFE"
        android:dashWidth="6dp"
        android:dashGap="4dp" />
</shape>
